{
  "name": "snackify",
  "version": "1.0.0",
  "private": true,
  "description": "Snackify static frontend for AWS Amplify Hosting",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "npm run build:css && node scripts/build.mjs",
    "build:css": "tailwindcss -i styles/input.css -o styles.css --minify",
    "prestart": "npm run build",
    "start": "serve dist --listen 3000 --no-clipboard",
    "preview": "serve dist --listen 3000 --no-clipboard",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {},
  "devDependencies": {
    "serve": "^14.2.0",
    "tailwindcss": "3.4.17",
    "@playwright/test": "1.64.0"
  }
}
